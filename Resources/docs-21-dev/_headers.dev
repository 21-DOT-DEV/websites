# Cloudflare Pages Headers — docs.21.dev (Preview/Development)
# Preview builds serve static DocC content without HSTS for safety.

# Cloudflare Pages applies ALL matching rules (first-match does not win) and concatenates repeated header keys in file order; keep specific asset patterns above the catch-all /* sections below.

# JavaScript bundle (DocC search) — content-hashed filenames, safe to mark immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding
  X-Robots-Tag: noindex

# CSS stylesheets (DocC theme) — content-hashed filenames, safe to mark immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding
  X-Robots-Tag: noindex

# DocC renderer UI icons — webpack content-hashed, safe to mark immutable
/img/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding
  X-Robots-Tag: noindex

# Author-provided assets (@Image, @Video, @Download) — filenames not hashed, daily TTL
/images/*
  Cache-Control: public, max-age=86400
  Vary: Accept-Encoding

/videos/*
  Cache-Control: public, max-age=86400
  Vary: Accept-Encoding

/downloads/*
  Cache-Control: public, max-age=86400
  Vary: Accept-Encoding

# /.well-known/* — no-store for the whole namespace, matching 21.dev and the
# Specs/003 quickstart checks. _headers can't remove a header it set (Pages
# does not honor `!` detaches — see functions/_handlers/html.ts), so a future
# cacheable well-known (e.g. jwks.json) needs a Pages Function.
/.well-known/*
  Cache-Control: no-store
  Pragma: no-cache

# security.txt (RFC 9116) — explicit text/plain, defensive against MIME-mapping drift
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff

# DocC data directory (symbol JSON)
/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Vary: Accept-Encoding
  X-Robots-Tag: noindex

# Explicit Content-Type for DocC markdown assets — defensive against MIME-mapping
# drift (NGINX-style defaults historically lacked .md; combined with the catch-all's
# X-Content-Type-Options: nosniff, an incorrect type would silently block crawlers).
# One splat matches any depth — a second `*` would make the rule match nothing.
# cfpages-ignore: glob-content-type (DocC emits .md at unbounded depth; explicit paths impractical — 404s under this prefix also serve text/markdown, accepted)
/data/documentation/*.md
  Content-Type: text/markdown; charset=utf-8

# No catch-all .json rule: `/**/*.json` uses more than one `*` — invalid on
# Pages, it silently matched nothing. /data/* above covers DocC JSON;
# root/index .json files keep Cloudflare's max-age=0 default, right for config.

# Serve plain text files with correct content-type
# Using explicit paths instead of /*.txt glob to avoid Content-Type mismatch on 404 pages
/llms.txt
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff

/robots.txt
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex

# Content negotiation: markdown alternate for AI agents
/documentation/*
  Vary: Accept

# Preview HTML (DocC) — security headers without HSTS, noindex to prevent search indexing
# NOTE: Extend CSP allowlists by appending origins (e.g., extra script host) instead of removing defaults to keep minimum protections intact.
# Link relations and X-Llms-Txt are emitted by _handlers/html.ts via buildHtmlLinkHeader,
# not from /* here. See _headers.prod for the full rationale.
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://static.cloudflareinsights.com; font-src 'self' data:; img-src 'self' data:; script-src 'self' https://static.cloudflareinsights.com 'sha256-Tmnua9Q+ofeiLwDiFowbjAxSJRmhO2KE+f0QIsqwNfw='; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), fullscreen=(self)
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Robots-Tag: noindex, nofollow
